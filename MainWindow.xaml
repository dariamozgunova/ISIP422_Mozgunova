<Window x:Class="ISIP422_Mozgunova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP422_Mozgunova"
        mc:Ignorable="d"
        Title="Учёт товаров" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт товаров в магазине." 
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" 
                   Margin="10"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Добавить товар" Click="AddProduct_Click" Width="120" Height="30" Margin="5"/>
                <Button Content="Удалить товар" Click="DeleteProduct_Click" Width="120" Height="30" Margin="5"/>
                <Button Content="Продать товар" Click="SellProduct_Click" Width="120" Height="30" Margin="5"/>
                <Button Content="Заказать поставку" Click="OrderSupply_Click" Width="120" Height="30" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Name="SearchTextBox" Width="200" Height="25" Margin="5,0" 
                         TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" Name="ProductsGrid" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90"/>
                <DataGridCheckBoxColumn Header="В наличии" Binding="{Binding IsAvailable}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Name="StatusText" Margin="10" Padding="5" Background="LightGray"/>
    </Grid>
</Window>
